# GET Quest — Environment Configuration
# Copy to .env for local development. NEVER commit .env to git.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: leave blank → SQLite is used automatically (data/get_quest.db)
# Production (Neon/Render): paste the full Neon connection string here
DATABASE_URL=

# ── Optional AI Question Lab ──────────────────────────────────────────────────
# The app works 100% offline without these. Set only if you want AI question generation.
# Supported providers: gemini | openai
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_key_here
# GEMINI_API_KEY=your_gemini_key_here   (alternative if AI_PROVIDER not set)
# OPENAI_API_KEY=your_openai_key_here   (alternative)
