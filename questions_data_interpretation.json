      "id": "C021",
      "track": "cognitive",
      "topic": "Data Interpretation",
      "difficulty": "easy",
      "question": "A plant produces 120 units in one shift and 150 in the next. What is the percentage increase?",
      "options": [
        {
          "id": "A",
          "text": "20%"
        },
        {
          "id": "B",
          "text": "25%"
        },
        {
          "id": "C",
          "text": "30%"
        },
        {
          "id": "D",
          "text": "35%"
        }
      ],
      "correct_option_id": "B",
      "correct_answer": "25%",
      "explanation": "Increase = 150 − 120 = 30. Percentage increase = 30/120 × 100 = 25%.",
      "recommended_time_seconds": 35,
      "tags": [
        "data_interpretation",
        "percentages"
      ],
      "provenance": {
